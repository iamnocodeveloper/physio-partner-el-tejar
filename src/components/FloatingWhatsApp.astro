---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';

const whatsappUrl = `https://wa.me/${clinicaData.whatsapp}?text=${encodeURIComponent(clinicaData.whatsappMensajeDefault)}`;
---

<div class="fixed bottom-20 xl:bottom-6 right-4 sm:right-6 z-40 flex items-center gap-3">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp directamente con Physio Partner"
    class="group flex items-center gap-2.5 pl-3.5 pr-4 sm:pl-4 sm:pr-5 py-2.5 sm:py-3 rounded-full bg-[#25D366] text-white shadow-[0_8px_24px_rgba(37,211,102,0.35)] hover:shadow-[0_12px_28px_rgba(37,211,102,0.45)] hover:-translate-y-0.5 transition-all duration-200"
  >
    <div class="relative flex items-center justify-center">
      <Icon name="whatsapp" size={24} />
      <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
      </span>
    </div>
    <span class="font-label-lg text-xs sm:text-label-lg tracking-wide font-bold hidden sm:inline">
      Escríbenos por WhatsApp
    </span>
  </a>
</div>
