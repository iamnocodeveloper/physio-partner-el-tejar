---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';
---

<section class="w-full py-12 sm:py-20 bg-surface" id="opiniones">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex flex-col gap-8 sm:gap-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="flex flex-col gap-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container/60 text-secondary font-label-sm text-label-sm uppercase tracking-widest font-bold">
          05 / TESTIMONIOS
        </div>
        <h2 class="font-headline-lg text-[26px] leading-[32px] sm:text-headline-lg-mobile lg:text-headline-lg text-on-surface font-bold">
          LA CONFIANZA DE QUIENES NOS VISITAN
        </h2>
        <p class="font-body-md sm:font-body-lg text-body-md sm:text-body-lg text-on-surface-variant">
          La experiencia y recuperación de nuestros pacientes es nuestro mayor aval de trabajo y compromiso en Cuenca.
        </p>
      </div>

      <a
        href={clinicaData.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-surface-container-low text-primary font-label-lg text-label-lg hover:bg-surface-container transition-all w-fit border border-surface-container"
      >
        <span class="text-amber-500"><Icon name="star" size={20} filled={true} /></span>
        Ver opiniones en Google
      </a>
    </div>

    <!-- 3 Testimonios Destacados -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      {clinicaData.testimonios.map((testimonio) => (
        <div class="bg-surface-container-lowest p-6 sm:p-8 rounded-3xl shadow-sm flex flex-col justify-between gap-6 border border-surface-container">
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-1 text-amber-500">
              {Array.from({ length: testimonio.estrellas }).map(() => (
                <Icon name="star" size={20} filled={true} />
              ))}
            </div>
            <p class="font-body-md text-sm sm:text-body-md text-on-surface-variant leading-relaxed italic">
              "{testimonio.texto}"
            </p>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-surface-container">
            <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-headline-sm text-headline-sm font-bold shrink-0">
              {testimonio.iniciales}
            </div>
            <div>
              <p class="font-headline-sm text-label-md sm:text-label-lg text-on-surface font-bold">
                {testimonio.autor}
              </p>
              <p class="font-label-sm text-[11px] text-outline">
                {testimonio.tipo}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="text-center font-label-sm text-xs text-outline">
      * Testimonios ilustrativos de pacientes reales — pendientes de enlazar con módulo de reseñas Google verificadas.
    </p>
  </div>
</section>
