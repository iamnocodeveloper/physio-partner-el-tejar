---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';
---

<footer class="w-full bg-inverse-surface text-surface py-12 sm:py-16 pb-28 xl:pb-16 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10">
    <!-- Columna 1: Marca y Redes -->
    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <img
          src="/fotos/logo.png"
          alt="Physio Partner El Tejar Logo"
          class="h-8 w-auto object-contain brightness-0 invert"
          width="32"
          height="32"
          loading="lazy"
        />
        <div class="flex flex-col">
          <span class="font-headline-sm text-headline-sm text-white tracking-tight leading-none font-bold">
            PHYSIO PARTNER
          </span>
          <span class="font-label-sm text-xs text-surface-dim uppercase leading-tight">
            El Tejar · Fisioterapia
          </span>
        </div>
      </div>
      
      <p class="font-body-sm text-xs sm:text-body-sm text-surface-dim leading-relaxed">
        Centro especializado en rehabilitación física biomecánica, readaptación somática y fisioterapia avanzada en Cuenca, Ecuador.
      </p>

      <div class="flex items-center gap-3 pt-1">
        {clinicaData.redes.map((red) => (
          <a
            href={red.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={red.nombre}
            class="w-9 h-9 rounded-full bg-surface-container-highest/20 hover:bg-primary flex items-center justify-center text-white transition-colors"
          >
            <Icon name={red.icono} size={18} />
          </a>
        ))}
      </div>
    </div>

    <!-- Columna 2: Navegación Rápida -->
    <div class="space-y-3">
      <h3 class="font-headline-sm text-base sm:text-headline-sm text-white font-bold">Navegación Rápida</h3>
      <ul class="space-y-2 text-xs sm:text-body-sm">
        <li><a href="/#inicio" class="text-surface-dim hover:text-white transition-colors">Inicio y Presentación</a></li>
        <li><a href="/#tratamientos" class="text-surface-dim hover:text-white transition-colors">Tratamientos Especializados</a></li>
        <li><a href="/#nosotros" class="text-surface-dim hover:text-white transition-colors">Filosofía Terapéutica</a></li>
        <li><a href="/#proceso" class="text-surface-dim hover:text-white transition-colors">Protocolo de 3 Fases</a></li>
        <li><a href="/#equipo" class="text-surface-dim hover:text-white transition-colors">Especialistas Certificados</a></li>
        <li><a href="/#agenda" class="text-surface-dim hover:text-white transition-colors">Reserva de Citas</a></li>
      </ul>
    </div>

    <!-- Columna 3: Horarios de Atención -->
    <div class="space-y-3">
      <h3 class="font-headline-sm text-base sm:text-headline-sm text-white font-bold">Horarios de Atención</h3>
      <ul class="space-y-2 font-body-sm text-xs sm:text-body-sm text-surface-dim">
        <li class="flex justify-between gap-4">
          <span>Lunes a Viernes:</span>
          <span class="text-white font-medium">07:30 – 19:30</span>
        </li>
        <li class="flex justify-between gap-4">
          <span>Sábados:</span>
          <span class="text-white font-medium">08:00 – 13:00</span>
        </li>
        <li class="flex justify-between gap-4">
          <span>Domingos & Feriados:</span>
          <span class="text-surface-dim/70">Previa Cita Prioritaria</span>
        </li>
      </ul>
      <div class="pt-2">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-highest/20 font-label-sm text-xs text-tertiary-fixed">
          <span class="w-2 h-2 rounded-full bg-tertiary-fixed animate-pulse"></span>
          Consultas con cita agendada
        </span>
      </div>
    </div>

    <!-- Columna 4: Sede El Tejar -->
    <div class="space-y-3">
      <h3 class="font-headline-sm text-base sm:text-headline-sm text-white font-bold">Sede El Tejar</h3>
      <div class="space-y-2 font-body-sm text-xs sm:text-body-sm text-surface-dim">
        <p class="flex items-start gap-2">
          <span class="text-tertiary-fixed shrink-0 mt-0.5"><Icon name="location_on" size={18} /></span>
          <span>{clinicaData.direccion}</span>
        </p>
        <p class="flex items-center gap-2">
          <span class="text-tertiary-fixed shrink-0"><Icon name="call" size={18} /></span>
          <span>{clinicaData.telefono} / {clinicaData.telefonoFijo}</span>
        </p>
        <p class="flex items-center gap-2">
          <span class="text-tertiary-fixed shrink-0"><Icon name="chat" size={18} /></span>
          <span>{clinicaData.email}</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Barra Inferior de Enlaces Legales y Copyright -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 mt-10 pt-6 border-t border-surface-container-highest/20 text-center space-y-3">
    <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-surface-dim">
      <a href="/aviso-legal" class="hover:text-white transition-colors underline">Aviso Legal</a>
      <span>•</span>
      <a href="/privacidad" class="hover:text-white transition-colors underline">Política de Privacidad</a>
      <span>•</span>
      <a href="/cookies" class="hover:text-white transition-colors underline">Política de Cookies</a>
    </div>

    <p class="font-body-sm text-xs text-surface-dim">
      © 2026 {clinicaData.nombre}. Todos los derechos reservados. Cuenca, Ecuador.
    </p>
    
    <p class="font-label-sm text-[11px] text-surface-dim/60 max-w-3xl mx-auto">
      Aviso médico: La información provista tiene carácter estrictamente informativo y no reemplaza la evaluación clínica personalizada efectuada por profesionales acreditados.
    </p>
  </div>
</footer>
