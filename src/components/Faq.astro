---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';
---

<section class="w-full py-12 sm:py-20 bg-surface" id="faq">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-12 flex flex-col gap-8 sm:gap-12">
    <div class="text-center flex flex-col items-center gap-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container/60 text-secondary font-label-sm text-label-sm uppercase tracking-widest font-bold">
        06 / PREGUNTAS FRECUENTES
      </div>
      <h2 class="font-headline-lg text-[26px] leading-[32px] sm:text-headline-lg-mobile lg:text-headline-lg text-on-surface font-bold">
        RESOLVEMOS TUS DUDAS
      </h2>
      <p class="font-body-md sm:font-body-lg text-body-md sm:text-body-lg text-on-surface-variant max-w-xl">
        Todo lo que necesitas saber antes de iniciar tu proceso de rehabilitación en PHYSIO PARTNER El Tejar.
      </p>
    </div>

    <!-- Contenedor del Acordeón Accesible -->
    <div class="flex flex-col gap-3.5 sm:gap-4" id="faqAccordion">
      {clinicaData.faq.map((item, idx) => (
        <div class="faq-item rounded-2xl bg-surface-container-lowest shadow-sm border border-surface-container overflow-hidden transition-all duration-200">
          <button
            type="button"
            class="faq-toggle w-full px-5 sm:px-6 py-4 sm:py-5 flex items-center justify-between text-left focus:outline-none focus:ring-2 focus:ring-primary focus:ring-inset cursor-pointer"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
            id={`faq-btn-${idx}`}
          >
            <span class="font-headline-sm text-base sm:text-headline-sm text-on-surface font-bold pr-4">
              {item.pregunta}
            </span>
            <span class="faq-icon text-primary transition-transform duration-200 shrink-0">
              <Icon name="expand_more" size={24} />
            </span>
          </button>
          
          <div
            id={`faq-answer-${idx}`}
            role="region"
            aria-labelledby={`faq-btn-${idx}`}
            class="faq-content hidden px-5 sm:px-6 pb-5 pt-2 text-on-surface-variant font-body-md text-sm sm:text-body-md leading-relaxed border-t border-surface-container"
          >
            <p>{item.respuesta}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const toggles = document.querySelectorAll('.faq-toggle');

  toggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      const item = toggle.closest('.faq-item');
      if (!item) return;

      const content = item.querySelector('.faq-content');
      const icon = toggle.querySelector('.faq-icon');

      // Cerrar otros acordeones abiertos para mantener orden y accesibilidad
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as HTMLElement).style.transform = 'rotate(0deg)');
      document.querySelectorAll('.faq-toggle').forEach(t => t.setAttribute('aria-expanded', 'false'));

      // Abrir o cerrar el actual
      if (!isExpanded && content && icon) {
        content.classList.remove('hidden');
        (icon as HTMLElement).style.transform = 'rotate(180deg)';
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
