---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';
---

<nav
  class="xl:hidden fixed bottom-0 left-0 right-0 z-40 bg-surface-container-lowest/95 backdrop-blur-md shadow-[0_-2px_12px_rgba(0,0,0,0.08)] px-2 py-1.5 flex items-center justify-around border-t border-surface-container"
  aria-label="Navegación rápida inferior móvil"
>
  <a
    href="/#inicio"
    class="flex flex-col items-center gap-0.5 py-1 px-2 text-on-surface-variant hover:text-primary transition-colors"
  >
    <Icon name="home" size={20} />
    <span class="font-label-sm text-[10px] font-medium">Inicio</span>
  </a>

  <a
    href="/#tratamientos"
    class="flex flex-col items-center gap-0.5 py-1 px-2 text-on-surface-variant hover:text-primary transition-colors"
  >
    <Icon name="healing" size={20} />
    <span class="font-label-sm text-[10px] font-medium">Servicios</span>
  </a>

  <a
    href="/#agenda"
    class="flex flex-col items-center gap-0.5 py-1 px-3 text-primary font-bold -mt-2 bg-secondary-container/40 rounded-xl"
  >
    <Icon name="calendar_month" size={22} />
    <span class="font-label-sm text-[11px]">Cita</span>
  </a>

  <a
    href={`tel:${clinicaData.telefonoLlamada}`}
    class="flex flex-col items-center gap-0.5 py-1 px-2 text-on-surface-variant hover:text-primary transition-colors"
    aria-label="Llamar por teléfono a la clínica"
  >
    <Icon name="phone_in_talk" size={20} />
    <span class="font-label-sm text-[10px] font-medium">Llamar</span>
  </a>

  <a
    href="/#ubicacion"
    class="flex flex-col items-center gap-0.5 py-1 px-2 text-on-surface-variant hover:text-primary transition-colors"
  >
    <Icon name="location_on" size={20} />
    <span class="font-label-sm text-[10px] font-medium">Mapa</span>
  </a>
</nav>
