---
import clinicaData from '../data/taller';
import Icon from './Icon.astro';
---

<section class="w-full py-12 sm:py-20 bg-surface-container-low" id="equipo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex flex-col gap-8 sm:gap-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="flex flex-col gap-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container/60 text-secondary font-label-sm text-label-sm uppercase tracking-widest font-bold">
          04 / NUESTRO EQUIPO
        </div>
        <h2 class="font-headline-lg text-[26px] leading-[32px] sm:text-headline-lg-mobile lg:text-headline-lg text-on-surface font-bold">
          PROFESIONALES COMPROMETIDOS CON TU BIENESTAR
        </h2>
        <p class="font-body-md sm:font-body-lg text-body-md sm:text-body-lg text-on-surface-variant">
          Atención guiada por terapeutas certificados con vocación humana y actualización científica constante en técnicas neuromusculares.
        </p>
      </div>
      <div class="px-4 py-2 rounded-xl bg-surface-container-highest/60 text-outline font-label-sm text-xs sm:text-label-sm w-fit">
        Perfiles ilustrativos referenciales
      </div>
    </div>

    <!-- Banner con Imagen y Valores del Equipo -->
    <div class="w-full rounded-3xl overflow-hidden shadow-lg bg-surface-container-lowest border border-surface-container">
      <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
        <div class="lg:col-span-5 h-[280px] sm:h-[340px] lg:h-[400px]">
          <img
            src="/fotos/equipo-clinico.jpg"
            alt="Evaluación y atención clínica profesional Physio Partner"
            class="w-full h-full object-cover object-center"
            width="500"
            height="400"
            loading="lazy"
          />
        </div>
        <div class="lg:col-span-7 p-6 sm:p-8 lg:p-12 flex flex-col justify-center gap-4">
          <span class="inline-flex items-center gap-2 text-primary font-label-sm text-xs sm:text-label-sm font-bold uppercase tracking-wider">
            <Icon name="verified_user" size={18} />
            Práctica clínica ética y colegiada
          </span>
          <h3 class="font-headline-md text-headline-sm sm:text-headline-md text-on-surface font-bold">
            Un enfoque de equipo multidisciplinar centrado en la persona
          </h3>
          <p class="font-body-sm sm:font-body-md text-on-surface-variant leading-relaxed">
            En cada consulta combinamos el criterio médico de la valoración con el rigor biomecánico del ejercicio terapéutico. Nuestro compromiso es que cada paciente entienda la causa de su molestia y participe activamente en su reintegración a sus hábitos cotidianos.
          </p>

          <div class="flex items-center gap-4 sm:gap-6 pt-2">
            <div>
              <p class="font-headline-sm text-[18px] sm:text-headline-sm text-primary font-bold">100%</p>
              <p class="font-label-sm text-xs sm:text-label-sm text-on-surface-variant">Titulados y colegiados</p>
            </div>
            <div class="h-8 w-px bg-outline-variant/40"></div>
            <div>
              <p class="font-headline-sm text-[18px] sm:text-headline-sm text-primary font-bold">1 a 1</p>
              <p class="font-label-sm text-xs sm:text-label-sm text-on-surface-variant">Atención en cada sesión</p>
            </div>
            <div class="h-8 w-px bg-outline-variant/40"></div>
            <div>
              <p class="font-headline-sm text-[18px] sm:text-headline-sm text-primary font-bold">Cuenca</p>
              <p class="font-label-sm text-xs sm:text-label-sm text-on-surface-variant">Sede propia en El Tejar</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tarjetas de Roles Profesionales -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {clinicaData.equipo.map((miembro) => (
        <div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col gap-3 border border-surface-container">
          <div class="w-12 h-12 rounded-xl bg-surface-container text-primary flex items-center justify-center">
            <Icon name={miembro.icono} size={24} />
          </div>
          <h4 class="font-headline-sm text-[18px] sm:text-headline-sm text-on-surface font-bold">
            {miembro.rol}
          </h4>
          <span class="font-label-sm text-xs sm:text-label-sm text-primary font-semibold">
            {miembro.especialidad}
          </span>
          <p class="font-body-sm text-xs sm:text-body-sm text-on-surface-variant leading-relaxed">
            {miembro.descripcion}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
